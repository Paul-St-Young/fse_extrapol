c       describes geometry
c       L_alpha=ell, el2=L/2, elli=1/L, tpiell=2 pi / L
      integer ndim
      parameter (ndim=3)
      real*8 ell,el2,elli,tpiell
      common/geometry/ell(ndim),el2(ndim),elli(ndim),tpiell(ndim)
      real*8 pi
      parameter  (pi=3.14159265358979323846264338327950d0)
